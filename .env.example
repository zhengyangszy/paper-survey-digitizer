# ===== 模型接入（必填）=====
# OpenCode Go 的 API Key
OPENAI_API_KEY=在这里粘贴你的OpenCodeGo密钥
# OpenAI 兼容端点 Base URL（OpenCode Go）
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# 识别用模型（多模态）。注意两点：
# 1. 必须「全小写」，与 GET /models 返回值逐字一致（大小写错了会报 Model is unavailable）
# 2. 必须是视觉模型。经济之选：mimo-v2.6-flash（最便宜，实测能读问卷）；备选 gpt-6-luna、gemini-4-argon
# 用法：node scripts/test-vision.js <模型ID> 可先探测某模型能否看图
LLM_MODEL=mimo-v2.6-flash
# 会话 ID（OpenCode Go 要求每个请求带稳定 x-opencode-session；留空则自动生成）
# LLM_SESSION_ID=paper-survey-digitizer-001

# ===== 审核与导出（可选，有默认值）=====
# 置信度低于该值的字段在审核页标红，默认 0.75
CONFIDENCE_THRESHOLD=0.75
# 每审核 N 份提示导出一批 CSV，默认 50
EXPORT_BATCH_SIZE=50
# 服务端口
PORT=3000
